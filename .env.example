# Copy to .env (next to docker-compose.yml) and adjust. Every value is optional; defaults shown.
MERIDIAN_DATA=./data        # library files + meridian.db (any absolute or relative path)
MERIDIAN_IMPORT=./import    # optional read-only folder for server-side imports
MERIDIAN_UID=1000           # set to the output of `id -u`
MERIDIAN_GID=1000           # set to the output of `id -g`
MERIDIAN_PORT=8000

# Admin mode. Everyone can browse the library; uploading, editing, deleting and the maintenance tools need a login
# (menu > Admin mode; the user name is always "admin"). Set a password to turn access control on. Leave it empty and every write is allowed.
MERIDIAN_ADMIN_PASSWORD=change-me-to-a-long-random-password
